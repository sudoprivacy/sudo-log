SUDO_LOG_PORT=8080
API_KEY_HEADER=X-API-Key
DEFAULT_API_KEY=key_exp
SUDO_LOG_ADMIN_STATIC_DIR=./packages/admin/src

SUDO_LOG_ADMIN_USERNAME=admin
SUDO_LOG_ADMIN_EMAIL=admin@sudoprivacy.com
SUDO_LOG_ADMIN_PASSWORD=admin123
SUDO_LOG_ADMIN_PASSWORD_HASH=
SUDO_LOG_JWT_SECRET=sudo-log-dev-secret-change-me
SUDO_LOG_JWT_ISSUER=sudo-log
SUDO_LOG_ACCESS_TOKEN_TTL_SECONDS=28800

REDIS_URL=redis://127.0.0.1:6380/0
SUDO_LOG_REDIS_KEY_PREFIX=sudo-log

POSTGRES_URL=postgres://sudo@127.0.0.1:5433/sudo_log

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=sudo_log
CLICKHOUSE_USER=sudo
CLICKHOUSE_PASSWORD=sudo_log_dev_password

GRAFANA_ENABLED=false
GRAFANA_PUBLIC_BASE_PATH=/grafana
GRAFANA_INTERNAL_URL=http://127.0.0.1:3000
GRAFANA_DATASOURCE_UID=sudo-log-clickhouse
GRAFANA_API_USER=admin
GRAFANA_API_PASSWORD=admin
GRAFANA_PUBLISH_ENABLED=true
GRAFANA_ORG_ID=1
GRAFANA_AUTH_PROXY_HEADER=X-WEBAUTH-USER
GRAFANA_CLICKHOUSE_DATABASE=sudo_log_grafana
GRAFANA_CLICKHOUSE_USER=grafana_reader
GRAFANA_CLICKHOUSE_PASSWORD=grafana_reader_password
GRAFANA_DETAIL_EVENTS_ENABLED=false
GRAFANA_DETAIL_TTL_DAYS=7
GRAFANA_METRICS_TTL_DAYS=30
GRAFANA_DEFAULT_TAG_KEY=feature
GRAFANA_DEFAULT_TAG_VALUE=
GRAFANA_ROOT_URL=http://localhost:8088/grafana/
GRAFANA_LIVE_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5180,http://127.0.0.1:5180

SUDO_LOG_BLOB_DIR=./data/blobs
SUDO_LOG_MAX_BODY_BYTES=2097152
SUDO_LOG_QUEUE_NAME=logs
SUDO_LOG_QUEUE_BATCH_SIZE=100
SUDO_LOG_QUEUE_POLL_INTERVAL_MS=500
SUDO_LOG_QUEUE_RETRY_DELAY_MS=3000
